@model Prospera.Models.Contas

@{
    ViewData["Title"] = "Cadastro de Receitas";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Prospera</title>
    <link rel="icon" href="/img/Favicon.png" type="image/x-icon">
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/MenuUsuario.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/ModalSystem.css" asp-append-version="true">
</head>
<body style="overflow: hidden;">
    <!-- Modal Overlay -->
    <div class="modal-overlay" id="receitasModal">
        <div class="modal-container">
            <!-- Header -->
            <div class="modal-header">
                <h2>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
                    </svg>
                    Cadastro de Receitas
                </h2>
                <button type="button" class="modal-close-btn" onclick="window.location.href='/Home/MenuUsuario'">&times;</button>
            </div>

            <!-- Body -->
            <div class="modal-body">
                <!-- Mensagens de validação -->
                @if (TempData["MensagemSucesso"] != null)
                {
                    <div class="alert alert-success">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>@TempData["MensagemSucesso"]</span>
                    </div>
                }

                @if (TempData["MensagemErro"] != null)
                {
                    <div class="alert alert-error">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                        <span>@TempData["MensagemErro"]</span>
                    </div>
                }

                <!-- Formulário -->
                <form asp-controller="Contas" asp-action="CadastrarReceita" method="post" id="receitaForm">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label required">Nome da Receita</label>
                            <input type="text" asp-for="NomeCont" class="form-input" placeholder="Ex: Salário, Freelance" maxlength="30" required>
                            <span asp-validation-for="NomeCont" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">Valor (R$)</label>
                            <input type="number" asp-for="ValorCont" class="form-input" placeholder="0,00" step="0.01" min="0" required>
                            <span asp-validation-for="ValorCont" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">Data de Vencimento</label>
                            <input type="date" asp-for="DatVenciCont" class="form-input" required>
                            <span asp-validation-for="DatVenciCont" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">Forma de Pagamento</label>
                            <select asp-for="MetodoPgtoCont" class="form-select" required>
                                <option value="">Selecione...</option>
                                <option value="PIX">PIX</option>
                                <option value="Transferência">Transferência</option>
                                <option value="Dinheiro">Dinheiro</option>
                                <option value="Cheque">Cheque</option>
                                <option value="Cartão">Cartão</option>
                            </select>
                            <span asp-validation-for="MetodoPgtoCont" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">Status</label>
                            <select asp-for="StatusCont" class="form-select" required>
                                <option value="">Selecione...</option>
                                <option value="Recebido">Recebido</option>
                                <option value="Pendente">Pendente</option>
                                <option value="Atrasado">Atrasado</option>
                            </select>
                            <span asp-validation-for="StatusCont" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">ID do Pagador</label>
                            <input type="number" asp-for="RecebedorCont" class="form-input" placeholder="Opcional" min="0">
                            <span asp-validation-for="RecebedorCont" class="text-danger"></span>
                        </div>

                        <div class="form-group full-width">
                            <label class="form-label">Observação</label>
                            <textarea asp-for="ObservacaoCont" class="form-textarea" placeholder="Detalhes adicionais sobre a receita" maxlength="200"></textarea>
                            <span asp-validation-for="ObservacaoCont" class="text-danger"></span>
                        </div>

                        <div class="form-group" style="display: none;">
                            <input type="number" asp-for="CodigoCont" class="form-input" readonly>
                        </div>
                    </div>

                    <input type="hidden" name="acao" id="acao" value="cadastro" />

                    <!-- Botões de Ação -->
                    <div class="button-group">
                        <button type="submit" name="btnAcao" value="Cadastro" class="btn btn-success">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                                <polyline points="17 21 17 13 7 13 7 21"></polyline>
                                <polyline points="7 3 7 8 15 8"></polyline>
                            </svg>
                            Cadastrar
                        </button>

                        <button type="submit" name="btnAcao" value="Alterar" class="btn btn-warning">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                            Alterar
                        </button>

                        <button type="submit" name="btnAcao" value="Excluir" class="btn btn-danger" onclick="return confirmAction('Tem certeza que deseja excluir esta receita?')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                                <path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"></path>
                            </svg>
                            Excluir
                        </button>

                        <button type="button" class="btn btn-primary" id="btnBuscar">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <circle cx="11" cy="11" r="8"></circle>
                                <path d="m21 21-4.35-4.35"></path>
                            </svg>
                            Buscar
                        </button>

                        <button type="button" class="btn btn-secondary" onclick="clearForm('receitaForm')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"></polyline>
                                <polyline points="23 20 23 14 17 14"></polyline>
                                <path d="M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"></path>
                            </svg>
                            Limpar
                        </button>

                        <button type="button" class="btn btn-outline" onclick="window.location.href='/Home/MenuUsuario'">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                                <polyline points="12 19 5 12 12 5"></polyline>
                            </svg>
                            Voltar
                        </button>
                    </div>
                </form>

                <!-- Área de Busca -->
                <div class="search-bar" style="margin-top: 3rem;">
                    <div class="search-input-group">
                        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                        <input type="text" id="searchInput" class="search-input" placeholder="Buscar receitas por nome, valor, status...">
                    </div>
                </div>

                <!-- Tabela de Receitas -->
                <div class="data-table-container">
                    <table class="data-table" id="receitasTable">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Nome</th>
                                <th>Valor</th>
                                <th>Vencimento</th>
                                <th>Pagamento</th>
                                <th>Status</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="receitasTableBody">
                            <!-- Dados serão carregados dinamicamente -->
                            <tr>
                                <td colspan="7" style="text-align: center; padding: 2rem; color: #94A3B8;">
                                    Nenhuma receita cadastrada ainda
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="/js/ModalSystem.js" asp-append-version="true"></script>
    <script>
        // Inicializar modal
        const modal = new ModalSystem('receitasModal');
        
        // Configurar busca
        setupSearch('searchInput', 'receitasTableBody');
        
        // Botão buscar
        document.getElementById('btnBuscar').addEventListener('click', function() {
            // Implementar lógica de busca
            showAlert('Funcionalidade de busca em desenvolvimento', 'info');
        });
        
        // Validação do formulário
        document.getElementById('receitaForm').addEventListener('submit', function(e) {
            if (!validateForm('receitaForm')) {
                e.preventDefault();
                showAlert('Por favor, preencha todos os campos obrigatórios', 'error');
            }
        });
    </script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
