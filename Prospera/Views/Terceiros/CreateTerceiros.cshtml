@model Prospera.Models.Terceiros
@{ViewData["Title"] = "Devedor/Pagador"; Layout = null;}
<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Prospera</title><link rel="icon" href="/img/Favicon.png" type="image/x-icon">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/MenuUsuario.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/ModalSystem.css" asp-append-version="true">
</head>
<body style="overflow: hidden;">
    <div class="modal-overlay" id="terceirosModal">
        <div class="modal-container">
            <div class="modal-header">
                <h2>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle>
                        <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                    </svg>
                    Devedor/Pagador
                </h2>
                <button type="button" class="modal-close-btn" onclick="window.location.href='/Home/MenuUsuario'">&times;</button>
            </div>
            <div class="modal-body">
                <form asp-controller="Terceiros" asp-action="CreateTerceiros" method="post" id="terceirosForm">
                    <div class="form-grid">
                        <div class="form-group"><label class="form-label required">Nome</label>
                            <input type="text" asp-for="NomeTerceiros" class="form-input" placeholder="Nome completo" required>
                            <span asp-validation-for="NomeTerceiros" class="text-danger"></span></div>
                        <div class="form-group"><label class="form-label">Telefone</label>
                            <input type="text" asp-for="TelefoneTerceiros" class="form-input" placeholder="(00) 00000-0000">
                            <span asp-validation-for="TelefoneTerceiros" class="text-danger"></span></div>
                        <div class="form-group"><label class="form-label">Email</label>
                            <input type="email" asp-for="EmailTerceiros" class="form-input" placeholder="email@exemplo.com">
                            <span asp-validation-for="EmailTerceiros" class="text-danger"></span></div>
                        <div class="form-group"><label class="form-label">Endereço</label>
                            <input type="text" asp-for="EnderecoTerceiros" class="form-input" placeholder="Rua, Número">
                            <span asp-validation-for="EnderecoTerceiros" class="text-danger"></span></div>
                        <div class="form-group full-width"><label class="form-label">Observação</label>
                            <textarea asp-for="ObservacaoTerceiros" class="form-textarea" placeholder="Detalhes adicionais"></textarea>
                            <span asp-validation-for="ObservacaoTerceiros" class="text-danger"></span></div>
                        <div class="form-group" style="display: none;">
                            <input type="number" asp-for="IdTerceiros" class="form-input" readonly></div>
                    </div>
                    <div class="button-group">
                        <button type="submit" name="btnAcao" value="Cadastro" class="btn btn-success"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path></svg>Cadastrar</button>
                        <button type="submit" name="btnAcao" value="Alterar" class="btn btn-warning"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path></svg>Alterar</button>
                        <button type="submit" name="btnAcao" value="Excluir" class="btn btn-danger" onclick="return confirmAction('Deseja excluir?')"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"></polyline></svg>Excluir</button>
                        <button type="button" class="btn btn-secondary" onclick="clearForm('terceirosForm')"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="1 4 1 10 7 10"></polyline></svg>Limpar</button>
                        <button type="button" class="btn btn-outline" onclick="window.location.href='/Home/MenuUsuario'"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="19" y1="12" x2="5" y2="12"></line></svg>Voltar</button>
                    </div>
                </form>
                <div class="search-bar" style="margin-top: 3rem;"><div class="search-input-group">
                    <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path></svg>
                    <input type="text" id="searchInput" class="search-input" placeholder="Buscar..."></div></div>
                <div class="data-table-container"><table class="data-table"><thead><tr><th>ID</th><th>Nome</th><th>CPF</th><th>Telefone</th><th>Ações</th></tr></thead>
                    <tbody id="terceirosTableBody"><tr><td colspan="5" style="text-align: center; padding: 2rem; color: #94A3B8;">Nenhum cadastro</td></tr></tbody></table></div>
            </div>
        </div>
    </div>
    <script src="/js/ModalSystem.js" asp-append-version="true"></script>
    <script>new ModalSystem('terceirosModal');setupSearch('searchInput','terceirosTableBody');</script>
    @section Scripts{@{await Html.RenderPartialAsync("_ValidationScriptsPartial");}}
</body>
</html>
