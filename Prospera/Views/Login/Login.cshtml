@model LoginModel

@{
    Layout = "_LayoutDeslogado";
    ViewData["Title"] = "Login";
}

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <!-- link css -->
    <link rel="stylesheet" href="~/css/Login_Register.css" asp-append-version="true">
    <!-- Fonte inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400&family=Lato:ital,wght@1,100&display=swap" rel="stylesheet">

    <title>Prospera - Login</title>
</head>

<body>
    <!-- Toast de mensagens (popup flutuante) -->
    @if (TempData["MensagemErro"] != null)
    {
        <div class="toast-notification error" id="toastNotification">
            <div class="toast-icon">?</div>
            <div class="toast-content">
                <strong>Erro</strong>
                <p>@TempData["MensagemErro"]</p>
            </div>
            <button class="toast-close" onclick="document.getElementById('toastNotification').remove()">×</button>
        </div>
    }

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="toast-notification success" id="toastNotification">
            <div class="toast-icon">?</div>
            <div class="toast-content">
                <strong>Sucesso</strong>
                <p>@TempData["MensagemSucesso"]</p>
            </div>
            <button class="toast-close" onclick="document.getElementById('toastNotification').remove()">×</button>
        </div>
    }

    <!-- Session NavBar -->
    <section id="NavBar">
        <div class="MenuNav">
            <li class="ImgFundoLateral">
                <ul class="Nav-Container">
                    <img src="~/img/Login/IconeLogin.png" asp-append-version="true" alt="Ícone Login">
                    <img src="~/img/Login/Lateral.png" class="ImgLateral" asp-append-version="true" alt="Lateral">
                    <h2>PROSPERA</h2>
                    <li><a asp-controller="Home" asp-action="Index" id="BtnInicio">INICIO</a></li>
                </ul>

                <ul class="div-central container">
                    <li class="imgFund">
                        <img src="~/img/Login/LoginBanner.png" asp-append-version="true" alt="Banner Login">
                    </li>
           
                    <ul class="CardInfLogin">
                        <ul class="LoginInf">
                            <h2>Olá <br> Seja bem vindo</h2>

                            <form asp-controller="Login" asp-action="Entrar" method="post">
                                <li class="TxtLogin EspacoInput">
                                    <input asp-for="Email" type="text" placeholder="Email" id="TxtLogin">
                                </li>
                                @Html.ValidationMessageFor(x => x.Email)
                                
                                <li class="IconSenha"><img src="~/img/Login/IconSenha.png" asp-append-version="true" alt="Ícone Senha"></li>
                                <li class="IconLogin"><img src="~/img/Login/IconLogin.png" asp-append-version="true" alt="Ícone Login"></li>

                                <li class="TxtSenha EspacoInput">
                                    <input type="password" asp-for="Senha" placeholder="Senha" id="TxtSenha">
                                </li>
                                @Html.ValidationMessageFor(x => x.Senha)

                                <h4 class="CheckH4">
                                    <input type="checkbox" name="manterLogado" id="ChekManterLogado"> Manter logado?
                                </h4>

                                <li id="BtnLogin">
                                    <button type="submit" id="btn-transparent" class="btn btn-primary btn-block">LOGAR</button>
                                </li>
                            </form>

                            <!-- Btxt - Botão que na verdade esta dentro de um texto, h1 ou p... -->
                            <h4 class="BtxtInscrevase">Não tem conta? <a asp-controller="Cadastro" asp-action="Cadastro" id="BtnInscrevase">Inscreva-se</a></h4>

                            <h4 class="BtxtEsqSenha"><a href="#" id="BtnAjuda">Ajuda</a> <a href="#" id="BtnEsqSenha">Esqueceu a senha?</a></h4>
                        </ul>

                        <ul>
                        </ul>
                    </ul>
                </ul>
            </li>
        </div>
    </section>

    <!-- link js -->
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
        // Auto-hide toast após 5 segundos
        document.addEventListener('DOMContentLoaded', function() {
            const toast = document.getElementById('toastNotification');
            if (toast) {
                // Animar entrada
                setTimeout(() => {
                    toast.classList.add('show');
                }, 100);

                // Auto-hide
                setTimeout(() => {
                    toast.classList.remove('show');
                    setTimeout(() => toast.remove(), 300);
                }, 5000);
            }
        });
    </script>
</body>

</html>
