@model Prospera.Models.ContaBancaria

@{
    ViewData["Title"] = "Contas Bancárias";
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Prospera</title>
    <link rel="icon" href="/img/Favicon.png" type="image/x-icon">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/MenuUsuario.css" asp-append-version="true">
    <link rel="stylesheet" href="/css/ModalSystem.css" asp-append-version="true">
</head>
<body style="overflow: hidden;">
    <div class="modal-overlay" id="contasBancariasModal">
        <div class="modal-container">
            <div class="modal-header">
                <h2>
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <rect x="1" y="4" width="22" height="16" rx="2" ry="2"></rect>
                        <line x1="1" y1="10" x2="23" y2="10"></line>
                    </svg>
                    Contas Bancárias
                </h2>
                <button type="button" class="modal-close-btn" onclick="window.location.href='/Home/MenuUsuario'">&times;</button>
            </div>

            <div class="modal-body">
                @if (TempData["MensagemSucesso"] != null)
                {
                    <div class="alert alert-success">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
                            <polyline points="22 4 12 14.01 9 11.01"></polyline>
                        </svg>
                        <span>@TempData["MensagemSucesso"]</span>
                    </div>
                }

                @if (TempData["MensagemErro"] != null)
                {
                    <div class="alert alert-error">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="12" cy="12" r="10"></circle>
                            <line x1="15" y1="9" x2="9" y2="15"></line>
                            <line x1="9" y1="9" x2="15" y2="15"></line>
                        </svg>
                        <span>@TempData["MensagemErro"]</span>
                    </div>
                }

                <form asp-controller="ContaBancarias" asp-action="CreateContasBancarias" method="post" id="contaBancariaForm">
                    <div class="form-grid">
                        <div class="form-group">
                            <label class="form-label required">Nome do Banco</label>
                            <input type="text" asp-for="BancoContBan" class="form-input" placeholder="Ex: Banco do Brasil" required>
                            <span asp-validation-for="BancoContBan" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label required">Saldo (R$)</label>
                            <input type="number" asp-for="SaldoContBan" class="form-input" placeholder="0,00" step="0.01" required>
                            <span asp-validation-for="SaldoContBan" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Agência</label>
                            <input type="number" asp-for="AgenciaContBan" class="form-input" placeholder="0000">
                            <span asp-validation-for="AgenciaContBan" class="text-danger"></span>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Número da Conta</label>
                            <input type="number" asp-for="NumContBan" class="form-input" placeholder="00000">
                            <span asp-validation-for="NumContBan" class="text-danger"></span>
                        </div>

                        <div class="form-group full-width">
                            <label class="form-label">Observação</label>
                            <textarea asp-for="ObsContBan" class="form-textarea" placeholder="Detalhes adicionais"></textarea>
                            <span asp-validation-for="ObsContBan" class="text-danger"></span>
                        </div>

                        <div class="form-group" style="display: none;">
                            <input type="number" asp-for="IdContaBancaria" class="form-input" readonly>
                        </div>
                    </div>

                    <div class="button-group">
                        <button type="submit" name="btnAcao" value="Cadastro" class="btn btn-success">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"></path>
                            </svg>
                            Cadastrar
                        </button>
                        <button type="submit" name="btnAcao" value="Alterar" class="btn btn-warning">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
                            </svg>
                            Alterar
                        </button>
                        <button type="submit" name="btnAcao" value="Excluir" class="btn btn-danger" onclick="return confirmAction('Tem certeza que deseja excluir esta conta?')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="3 6 5 6 21 6"></polyline>
                            </svg>
                            Excluir
                        </button>
                        <button type="button" class="btn btn-secondary" onclick="clearForm('contaBancariaForm')">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="1 4 1 10 7 10"></polyline>
                            </svg>
                            Limpar
                        </button>
                        <button type="button" class="btn btn-outline" onclick="window.location.href='/Home/MenuUsuario'">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <line x1="19" y1="12" x2="5" y2="12"></line>
                            </svg>
                            Voltar
                        </button>
                    </div>
                </form>

                <div class="search-bar" style="margin-top: 3rem;">
                    <div class="search-input-group">
                        <svg class="search-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                            <circle cx="11" cy="11" r="8"></circle>
                            <path d="m21 21-4.35-4.35"></path>
                        </svg>
                        <input type="text" id="searchInput" class="search-input" placeholder="Buscar contas...">
                    </div>
                </div>

                <div class="data-table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>ID</th>
                                <th>Banco</th>
                                <th>Agência</th>
                                <th>Conta</th>
                                <th>Saldo</th>
                                <th>Ações</th>
                            </tr>
                        </thead>
                        <tbody id="contasTableBody">
                            <tr>
                                <td colspan="6" style="text-align: center; padding: 2rem; color: #94A3B8;">
                                    Nenhuma conta bancária cadastrada
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/ModalSystem.js" asp-append-version="true"></script>
    <script>
        const modal = new ModalSystem('contasBancariasModal');
        setupSearch('searchInput', 'contasTableBody');
        
        document.getElementById('contaBancariaForm').addEventListener('submit', function(e) {
            if (!validateForm('contaBancariaForm')) {
                e.preventDefault();
                showAlert('Por favor, preencha todos os campos obrigatórios', 'error');
            }
        });
    </script>

    @section Scripts {
        @{
            await Html.RenderPartialAsync("_ValidationScriptsPartial");
        }
    }
</body>
</html>
